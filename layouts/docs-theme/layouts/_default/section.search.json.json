{{- $searchPages := .RegularPagesRecursive -}}
{{- range site.Pages -}}
  {{- if and .IsSection .Params.cli_command_key (strings.HasPrefix .RelPermalink $.RelPermalink) (ne .RelPermalink $.RelPermalink) -}}
    {{- $searchPages = $searchPages | append . -}}
  {{- end -}}
{{- end -}}
{{- $entries := slice -}}
{{- if not .Params.exclude_search -}}
  {{- $entries = $entries | append (dict "title" .Title "description" (.Description | default .Summary | plainify) "content" (.Content | plainify) "url" .RelPermalink "logicalPath" .File.Path) -}}
{{- end -}}
{{- range $page := sort (where $searchPages "Params.exclude_search" "ne" true) "RelPermalink" -}}
  {{- $entries = $entries | append (dict "title" $page.Title "description" ($page.Description | default $page.Summary | plainify) "content" ($page.Content | plainify) "url" $page.RelPermalink "logicalPath" $page.File.Path) -}}
{{- end -}}
{{- $entries | jsonify -}}
