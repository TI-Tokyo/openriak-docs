{{- $searchPages := .RegularPagesRecursive -}}
{{- range site.Pages -}}
  {{- if and .IsSection .Params.cli_command_key (strings.HasPrefix .RelPermalink $.RelPermalink) (ne .RelPermalink $.RelPermalink) -}}
    {{- $searchPages = $searchPages | append . -}}
  {{- end -}}
{{- end -}}
[
  {{ dict "title" .Title "description" (.Description | default .Summary | plainify) "content" (.Content | plainify) "url" .RelPermalink "logicalPath" .File.Path | jsonify }}
{{- range $page := sort $searchPages "RelPermalink" -}}
  ,
  {{ dict "title" $page.Title "description" ($page.Description | default $page.Summary | plainify) "content" ($page.Content | plainify) "url" $page.RelPermalink "logicalPath" $page.File.Path | jsonify }}
{{- end }}
]
