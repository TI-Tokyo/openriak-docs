# Local OpenRiak Docker run diagnostics. Keep each run's report.json in Git,
# but do not version verbose logs or duplicate generated artifacts.
/tools/cache/openriak-docker/**/runs/*/logs/
/tools/cache/openriak-docker/**/runs/*/Dockerfile
/tools/cache/openriak-docker/**/runs/*/compose.yaml
/tools/cache/openriak-docker/**/runs/*/compose.single.yaml
/tools/cache/openriak-docker/**/runs/*/compose.cluster.yaml
/tools/cache/openriak-docker/**/runs/*/.env.example

# Hugo build output
/public/
/docker-wip/
/resources/_gen/
/.hugo_build.lock

/tools/cache/openriak-docker/**/runs/*/example.env

# OCI exports are local artifacts, including distributed results and custom outputs.
*.oci.tar
*.oci.tar.*

# Multi-platform test diagnostics and local OCI image archives.
/tools/cache/openriak-docker-multiarch/**/runs/*/logs/
/tools/cache/openriak-docker-multiarch/**/runs/*/Dockerfile
/tools/cache/openriak-docker-multiarch/**/runs/*/compose.single.yaml
/tools/cache/openriak-docker-multiarch/**/runs/*/compose.cluster.yaml
/tools/cache/openriak-docker-multiarch/**/runs/*/example.env
/tools/cache/openriak-docker-multiarch/**/image.oci.tar
/tools/cache/openriak-docker-multiarch/**/.dockerignore

# Rebuild-only artifact snapshots; reports and approval snapshots remain tracked.
/tools/cache/openriak-docker-multiarch/**/rebuilds/*/logs/
/tools/cache/openriak-docker-multiarch/**/rebuilds/*/Dockerfile
/tools/cache/openriak-docker-multiarch/**/rebuilds/*/compose.single.yaml
/tools/cache/openriak-docker-multiarch/**/rebuilds/*/compose.cluster.yaml
/tools/cache/openriak-docker-multiarch/**/rebuilds/*/example.env

# Isolated Docker integration checks retain reports and current generated files.
/tools/cache/openriak-docker-validation/**/logs/
/tools/cache/openriak-docker-validation/**/runs/*/Dockerfile
/tools/cache/openriak-docker-validation/**/runs/*/compose.single.yaml
/tools/cache/openriak-docker-validation/**/runs/*/compose.cluster.yaml
/tools/cache/openriak-docker-validation/**/runs/*/example.env

# Debian 11 repository validation keeps compact reports and current artifacts.
/tools/cache/openriak-docker-debian11-validation/**/logs/
/tools/cache/openriak-docker-debian11-validation/**/runs/*/Dockerfile
/tools/cache/openriak-docker-debian11-validation/**/runs/*/compose.single.yaml
/tools/cache/openriak-docker-debian11-validation/**/runs/*/compose.cluster.yaml
/tools/cache/openriak-docker-debian11-validation/**/runs/*/example.env
/tools/cache/openriak-docker-debian11-validation/**/.dockerignore

# Minimal-runtime experiments preserve compact reports and current artifacts.
/tools/cache/openriak-docker-minimal-validation/**/logs/
/tools/cache/openriak-docker-minimal-validation/**/runs/*/Dockerfile
/tools/cache/openriak-docker-minimal-validation/**/runs/*/compose.single.yaml
/tools/cache/openriak-docker-minimal-validation/**/runs/*/compose.cluster.yaml
/tools/cache/openriak-docker-minimal-validation/**/runs/*/example.env
/tools/cache/openriak-docker-minimal-validation/**/.dockerignore
/tools/cache/openriak-docker-minimal-validation/**/image.oci.tar

# Reusable patched bases: retain approvals/current Dockerfiles, not OCI blobs or diagnostics.
/tools/cache/openriak-docker-bases/**/image.oci.tar
/tools/cache/openriak-docker-bases/**/.dockerignore
/tools/cache/openriak-docker-bases/**/logs/
/tools/cache/openriak-docker-bases/**/runs/*/Dockerfile
/tools/cache/openriak-docker-minimal-validation/**/base-layout/
