            "value": "datatype"
          },
          {
            "type": "atom",
            "value": "integer"
          }
        ]
      },
      {
        "type": "tuple",
        "value": [
          {
            "type": "atom",
            "value": "default"
          },
          {
            "type": "atom",
            "value": "4"
          }
        ]
      },
      {
        "type": "tuple",
        "value": [
          {
            "type": "atom",
            "value": "validators"
          },
          {
            "type": "array",
            "value": [
              {
                "type": "text",
                "value": "target_nval_max"
              },
              {
                "type": "text",
                "value": "target_nval_min"
              }
            ]
          }
        ]
      },
      {
        "type": "tuple",
        "value": [
          {
            "type": "atom",
            "value": "commented"
          },
          {
            "type": "atom",
            "value": "4"
          }
        ]
      }
    ]
  },
