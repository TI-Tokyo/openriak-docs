  {
    "rawSchema": "{mapping, \"mdc.fullsync_interval.$cluster_name\", \"riak_repl.fullsync_interval\", [ {datatype, {duration, ms}}, {include_default, \"all\"}, {commented, \"30m\"} ]}.",
