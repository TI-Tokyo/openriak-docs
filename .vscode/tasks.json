{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Clean Docusaurus Cache",
      "type": "shell",
      "command": "rm -rf .docusaurus",
      "problemMatcher": [],
      "detail": "Removes the .docusaurus cache directory"
    },
    {
      "label": "Build Docker Container (Debug)",
      "type": "shell",
      "command": "docker compose -f ./docker/docker-compose.debug.yaml build --no-cache",
 			"options": {
   			"env": {
			    "DOCKER_BUILDKIT": "1",
   				"COMPOSE_BAKE": "true",
   			}			
			},
    },
    {
      "label": "Remove Docker Container",
      "type": "shell",
      "command": "docker container rm -f openriak-docs || true",
 			"options": {
   			"env": {
			    "DOCKER_BUILDKIT": "1",
   				"COMPOSE_BAKE": "true",
   			}			
			},
    },    
    {
      "label": "Start Docker Container (Debug)",
      "type": "shell",
      "command": "docker compose -f ./docker/docker-compose.debug.yaml up",
      "dependsOn": ["Clean Docusaurus Cache", "Remove Docker Container", "Build Docker Container (Debug)"],
 			"options": {
   			"env": {
			    "DOCKER_BUILDKIT": "1",
   				"COMPOSE_BAKE": "true",
   			}			
			},
      "isBackground": true,
      "problemMatcher": [
        {
          "pattern": [
            {
              "regexp": ".",
              "file": 1,
              "location": 2,
              "message": 3
            }
          ],
          "background": {
            "activeOnStart": true,
            "beginsPattern": "Debugger listening on",
            "endsPattern": "Docusaurus website is running"
          }
        }
      ]
    },
    {
      "label": "Start Docker Container (No Build) (Debug)",
      "type": "shell",
      "command": "docker compose -f ./docker/docker-compose.debug.yaml up",
      "dependsOn": ["Clean Docusaurus Cache", "Remove Docker Container", ],
 			"options": {
   			"env": {
			    "DOCKER_BUILDKIT": "1",
   				"COMPOSE_BAKE": "true",
   			}			
			},
      "isBackground": true,
      "problemMatcher": [
        {
          "pattern": [
            {
              "regexp": ".",
              "file": 1,
              "location": 2,
              "message": 3
            }
          ],
          "background": {
            "activeOnStart": true,
            "beginsPattern": "Debugger listening on",
            "endsPattern": "Docusaurus website is running"
          }
        }
      ]
    }

  ]
}
