{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Attach to openriak-docs",
            "type": "node",
            "request": "attach",
            "port": 9229,
            "address": "localhost",
            "restart": false,
            "localRoot": "${workspaceFolder}",
            "remoteRoot": "/openriak-docs",
            "protocol": "inspector",
            "skipFiles": ["<node_internals>/**"],
//            "preLaunchTask": "docker-run",
//            "postDebugTask": "docker-stop"
        }
    ]
}