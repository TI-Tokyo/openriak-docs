{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Start openriak-docs in debug mode",
			"type": "shell",
			"command": "docker compose -f ./docker/docker-compose.debug.yaml up --build",
			"problemMatcher": [],
			"isBackground": true
		},
		{
			"label": "docker-build",
			"type": "shell",
			"command": "docker compose -f ./docker/docker-compose.debug.yaml --progress=plain build openriak-docs",
  			"options": {
    			"env": {
				    "DOCKER_BUILDKIT": "1",
      				"COMPOSE_BAKE": "true",
    			}			
			},
			"problemMatcher": [],
		},
		{
			"label": "docker-run",
			"type": "shell",
			"command": "docker compose -f ./docker/docker-compose.debug.yaml up openriak-docs",
			"isBackground": true,
			"problemMatcher": {
				"owner": "custom",
				"pattern": {
					"regexp": "."
				},
				"background": {
					"activeOnStart": true,
					"beginsPattern": "Debugger listening on ws://0.0.0.0:9229",
					"endsPattern": "Debugger listening on ws://0.0.0.0:9229"
				}
			},
			"dependsOn": ["docker-build"]
		},
		{
			"label": "docker-stop",
			"type": "shell",
			"command": "docker compose -f ./docker/docker-compose.debug.yaml down"
		}
	]
}