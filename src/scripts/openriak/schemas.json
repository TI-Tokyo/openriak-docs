{
    "defaultRebarConfigFile":  "https://github.com/OpenRiak/riak/blob/{versionTagOrCommit}/rebar.config",
    "defaultRebarLockFile":    "https://github.com/OpenRiak/riak/blob/{versionTagOrCommit}/rebar.lock",
    "defaultRepo":             "riak",
    "defaultSchemaToRepoMappings": {
        "riak":           {"repo":"riak",        "fileUrl":"/blob/{tagOrCommit}/priv/riak.schema",
                           "repoUrl": "https://github.com/OpenRiak/riak.git"                           },
        "erlang_vm":      {"repo":"cuttlefish",  "fileUrl":"/blob/{tagOrCommit}/priv/erlang_vm.schema"      },
        "riak_core":      {"repo":"riak_core",   "fileUrl":"/blob/{tagOrCommit}/priv/riak_core.schema"      },
        "riak_api":       {"repo":"riak_api",    "fileUrl":"/blob/{tagOrCommit}/priv/riak_api.schema"       },
        "riak_kv":        {"repo":"riak_kv",     "fileUrl":"/blob/{tagOrCommit}/priv/riak_kv.schema"        },
        "riak_sysmon":    {"repo":"riak_sysmon", "fileUrl":"/blob/{tagOrCommit}/priv/riak_sysmon.schema"    },
        "bitcask":        {"repo":"bitcask",     "fileUrl":"/blob/{tagOrCommit}/priv/bitcask.schema"        },
        "bitcask_multi":  {"repo":"bitcask",     "fileUrl":"/blob/{tagOrCommit}/priv/bitcask_multi.schema"  },
        "eleveldb":       {"repo":"eleveldb",    "fileUrl":"/blob/{tagOrCommit}/priv/eleveldb.schema"       },
        "eleveldb_multi": {"repo":"eleveldb",    "fileUrl":"/blob/{tagOrCommit}/priv/eleveldb_multi.schema" },
        "leveled":        {"repo":"leveled",     "fileUrl":"/blob/{tagOrCommit}/priv/leveled.schema"        },
        "leveled_multi":  {"repo":"leveled",     "fileUrl":"/blob/{tagOrCommit}/priv/leveled_multi.schema"  },
        "multi_backend":  {"repo":"riak_kv",     "fileUrl":"/blob/{tagOrCommit}/priv/multi_backend.schema"  },
        "riak_repl":      {"repo":"riak_repl",   "fileUrl":"/blob/{tagOrCommit}/priv/riak_repl.schema"      }
    },
    "versions": {
        "3.2.3": { "tagOrCommit":"riak-3.2.3", "schemaToRepoMappings": {}, "rebarConfigFile": null, "rebarLockFile": null },
        "3.2.4": { "tagOrCommit":"riak-3.2.4", "schemaToRepoMappings": {}, "rebarConfigFile": null, "rebarLockFile": null },
        "3.2.5": { "tagOrCommit":"riak-3.2.5", "schemaToRepoMappings": {}, "rebarConfigFile": null, "rebarLockFile": null },
        "3.4.0": { "tagOrCommit":"riak-3.2.5", "schemaToRepoMappings": {}, "rebarConfigFile": null, "rebarLockFile": null }
    },
    "templates": {
        "default": [
            { "placeholderName": "release_version", "source": "version" },
            { "path":"https://github.com/OpenRiak/riak/blob/{versionTagOrCommit}/rel/vars.config"
            },
            { "placeholderName": "platform_base_dir", "value": "/usr/lib/riak" }
        ],
        "alpine": [
            { "placeholderName": "release_version", "source": "version" },
            { "path":"https://github.com/OpenRiak/riak/blob/{versionTagOrCommit}/rel/pkg/alpine/vars.config"
            }
        ],
        "deb": [
            { "placeholderName": "release_version", "source": "version" },
            { "path":"https://github.com/OpenRiak/riak/blob/{versionTagOrCommit}/rel/pkg/deb/vars.config"
            }
        ],
        "fbsdng": [
            { "placeholderName": "release_version", "source": "version" },
            { "path":"https://github.com/OpenRiak/riak/blob/{versionTagOrCommit}/rel/pkg/fbsdng/vars.config"
            }
        ],
        "#osx": [
            { "placeholderName": "release_version", "source": "version" },
            { "path":"https://github.com/OpenRiak/riak/blob/{versionTagOrCommit}/rel/pkg/osx/vars.config"
            }
        ],
        "rpm": [
            { "placeholderName": "release_version", "source": "version" },
            { "path":"https://github.com/OpenRiak/riak/blob/{versionTagOrCommit}/rel/pkg/rpm/vars.config.part"
            },
            { "path":"https://github.com/OpenRiak/riak/blob/{versionTagOrCommit}/rel/pkg/rpm/specfile",
              "after": "%% Platform-specific installation paths",
              "until": "EOF",
              "variables": [
                {"name":"_localstatedir", "value":"/var"},
                {"name":"_sysconfdir", "value":"/etc"},
                {"name":"_libdir", "value":"/usr/lib64"},
                {"pattern":"^%define\\s+(?<name>[^ ]+)\\s+(?<value>[^ ]+)$", "nameGroup": "name", "nameValue":"value"}
                ]
            }
        ]
    }
}
