# Copy this file to .env before running either Compose file.
# All values below match the generated defaults and may be edited.
# Every member of one cluster must use the same distributed cookie.
OPENRIAK_DISTRIBUTED_COOKIE=openriak-d6bf8b7b9928b2e8f3724a70181c74fe
OPENRIAK_MONITOR_INTERVAL_SECONDS=10
OPENRIAK_CLUSTER_POLL_SECONDS=1
OPENRIAK_CLUSTER_WAIT_SECONDS=300

# Single-node container, ports, and bind-mount source paths.
OPENRIAK_CONTAINER_NAME=openriak-kv-3.4.1-ubuntu-noble-otp26-arm64-node
OPENRIAK_PB_PORT=8087
OPENRIAK_HTTP_PORT=8098
OPENRIAK_CONFIG_PATH=./openriak-kv-3.4.1-ubuntu-noble-otp26-arm64-node/config
OPENRIAK_DATA_PATH=./openriak-kv-3.4.1-ubuntu-noble-otp26-arm64-node/data
OPENRIAK_LOGS_PATH=./openriak-kv-3.4.1-ubuntu-noble-otp26-arm64-node/logs

# Cluster-wide shared control-directory source path.
OPENRIAK_CLUSTER_CONTROL_PATH=./openriak-kv-3.4.1-ubuntu-noble-otp26-arm64-node-cluster-control

# Cluster node identities, ports, and bind-mount source paths.
OPENRIAK_NODE_1_HOST=node-01.cluster-a.openriak
OPENRIAK_NODE_1_CONTAINER_NAME=openriak-kv-3.4.1-ubuntu-noble-otp26-arm64-node-1
OPENRIAK_NODE_1_PB_PORT=18087
OPENRIAK_NODE_1_HTTP_PORT=18098
OPENRIAK_NODE_1_CONFIG_PATH=./openriak-kv-3.4.1-ubuntu-noble-otp26-arm64-node-1/config
OPENRIAK_NODE_1_DATA_PATH=./openriak-kv-3.4.1-ubuntu-noble-otp26-arm64-node-1/data
OPENRIAK_NODE_1_LOGS_PATH=./openriak-kv-3.4.1-ubuntu-noble-otp26-arm64-node-1/logs

