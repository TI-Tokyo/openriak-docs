# Created by TI Tokyo, www.tiot.jp, for the OpenRiak project at https://openriak.org
# WARNING: Edit only if you understand the effect of your changes.
# Original image tag: tiotjp/openriak-kv:3.4.0-rhel-9-otp26
# Copy this file to .env before running either Compose file.
# All values below match the generated defaults and may be edited.
# Every member of one cluster must use the same distributed cookie.
# IANA timezone for the process and entrypoint logs, for example Asia/Tokyo.
TZ=Etc/UTC
# Optional nonzero UID for riak; empty retains the package UID. Mounted directories are chowned.
RIAK_UID=
# Optional nonzero GID for riak; empty retains the package GID. Mounted directories are chowned.
RIAK_GID=
# Maximum size per OpenRiak logger file; initializes new configurations only.
RIAK_LOG_MAX_FILE_SIZE=1MB
# Maximum file count per OpenRiak logger handler; initializes new configurations only.
RIAK_LOG_MAX_FILES=10
# CPU limit per node, for example 2.0; 0 means unrestricted.
OPENRIAK_CPUS=0
# Memory limit per node, for example 4g; 0 means unrestricted.
OPENRIAK_MEMORY_LIMIT=0
# Maximum size of each Docker JSON log file per node.
OPENRIAK_DOCKER_LOG_MAX_SIZE=10m
# Maximum number of Docker JSON log files retained per node.
OPENRIAK_DOCKER_LOG_MAX_FILES=3
# Initial cookie; existing riak.conf wins and new followers adopt the coordinator cookie.
OPENRIAK_DISTRIBUTED_COOKIE=openriak-f04e9b299fd4b47905d7cd608754c607
# Seconds between running-node health checks.
OPENRIAK_MONITOR_INTERVAL_SECONDS=10
# Seconds between cluster discovery checks.
OPENRIAK_CLUSTER_POLL_SECONDS=1
# Maximum seconds to wait for cluster discovery approval.
OPENRIAK_CLUSTER_WAIT_SECONDS=300

# Single-node container, ports, and bind-mount source paths.
# Single-node Docker container name.
OPENRIAK_CONTAINER_NAME=openriak-kv-3.4.0-rhel-9-otp26-node
# Host port forwarded to container Protocol Buffers port 8087.
OPENRIAK_PB_PORT=8087
# Host port forwarded to container HTTP port 8098.
OPENRIAK_HTTP_PORT=8098
# Host bind-mount directory for /etc/riak configuration.
OPENRIAK_CONFIG_PATH=./openriak-kv-3.4.0-rhel-9-otp26-node/config
# Host bind-mount directory for /var/lib/riak data.
OPENRIAK_DATA_PATH=./openriak-kv-3.4.0-rhel-9-otp26-node/data
# Host bind-mount directory for /var/log/riak logs.
OPENRIAK_LOGS_PATH=./openriak-kv-3.4.0-rhel-9-otp26-node/logs

# Cluster-wide shared control-directory source path.
# Host directory shared by all cluster discovery participants.
OPENRIAK_CLUSTER_CONTROL_PATH=./openriak-kv-3.4.0-rhel-9-otp26-node-cluster-control

# Cluster node identities, ports, and bind-mount source paths.
# DNS hostname used to derive the OpenRiak KV nodename.
OPENRIAK_NODE_1_HOST=node-01.cluster-a.openriak
# Docker container name for this cluster node.
OPENRIAK_NODE_1_CONTAINER_NAME=openriak-kv-3.4.0-rhel-9-otp26-node-1
# Host port forwarded to container Protocol Buffers port 8087.
OPENRIAK_NODE_1_PB_PORT=18087
# Host port forwarded to container HTTP port 8098.
OPENRIAK_NODE_1_HTTP_PORT=18098
# Host bind-mount directory for /etc/riak configuration.
OPENRIAK_NODE_1_CONFIG_PATH=./openriak-kv-3.4.0-rhel-9-otp26-node-1/config
# Host bind-mount directory for /var/lib/riak data.
OPENRIAK_NODE_1_DATA_PATH=./openriak-kv-3.4.0-rhel-9-otp26-node-1/data
# Host bind-mount directory for /var/log/riak logs.
OPENRIAK_NODE_1_LOGS_PATH=./openriak-kv-3.4.0-rhel-9-otp26-node-1/logs

