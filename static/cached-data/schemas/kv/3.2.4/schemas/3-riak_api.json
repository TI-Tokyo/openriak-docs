{
  "mappings": {
    "listener.http.$name": {
      "properties": {
        "default": "{{web_ip}}:{{web_port}}",
        "datatype": {
          "type": "atom",
          "value": "ip"
        },
        "include_default": "internal"
      },
      "comment": [
        "HTTP Listeners",
        "@doc listener.http.<name> is an IP address and TCP port that the Riak",
        "HTTP interface will bind."
      ],
      "configName": "listener.http.$name",
      "settingName": "riak_api.http"
    },
    "listener.protobuf.$name": {
      "properties": {
        "default": "{{pb_ip}}:{{pb_port}}",
        "datatype": {
          "type": "atom",
          "value": "ip"
        },
        "include_default": "internal"
      },
      "comment": [
        "@doc listener.protobuf.<name> is an IP address and TCP port that the Riak",
        "Protocol Buffers interface will bind."
      ],
      "configName": "listener.protobuf.$name",
      "settingName": "riak_api.pb"
    },
    "protobuf.backlog": {
      "properties": {
        "datatype": {
          "type": "atom",
          "value": "integer"
        },
        "default": "128",
        "commented": "128",
        "validators": [
          {
            "type": "text",
            "value": "greater_than_zero"
          }
        ]
      },
      "comment": [
        "@doc The maximum length to which the queue of pending connections",
        "may grow. If set, it must be an integer > 0. If you anticipate a",
        "huge number of connections being initialized *simultaneously*, set",
        "this number higher."
      ],
      "configName": "protobuf.backlog",
      "settingName": "riak_api.pb_backlog"
    },
    "protobuf.nagle": {
      "properties": {
        "datatype": {
          "type": "flag",
          "falseValue": "off",
          "trueValue": "on"
        },
        "default": "off",
        "hidden": true
      },
      "comment": [
        "@doc Turns off Nagle's algorithm for Protocol Buffers",
        "connections. This is equivalent to setting the TCP_NODELAY option",
        "on the socket."
      ],
      "configName": "protobuf.nagle",
      "settingName": "riak_api.disable_pb_nagle"
    },
    "protobuf.keepalive": {
      "properties": {
        "datatype": {
          "type": "atom",
          "value": "flag"
        },
        "default": "on",
        "hidden": true
      },
      "comment": [
        "@doc Turns on TCP keepalive for Protocol Buffers connections.",
        "This is equivalent to setting the SO_KEEPALIVE option on the socket."
      ],
      "configName": "protobuf.keepalive",
      "settingName": "riak_api.pb_keepalive"
    },
    "listener.https.$name": {
      "properties": {
        "commented": "{{web_ip}}:{{web_port}}",
        "datatype": {
          "type": "atom",
          "value": "ip"
