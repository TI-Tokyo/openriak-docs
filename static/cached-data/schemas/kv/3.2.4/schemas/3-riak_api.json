      ],
      "configName": "listener.https.$name",
      "settingName": "riak_api.https"
    },
    "honor_cipher_order": {
      "properties": {
        "datatype": {
          "type": "enum",
          "possibleValues": [
            {
              "type": "atom",
              "value": "on"
            },
            {
              "type": "atom",
              "value": "off"
            }
          ]
        },
        "default": "off",
        "hidden": true
      },
      "comment": [
        "@doc Whether to prefer the order in which the server lists its",
        "ciphers. When set to 'off', the client's preferred cipher order",
        "dictates which cipher is chosen."
      ],
      "configName": "honor_cipher_order",
      "settingName": "riak_api.honor_cipher_order"
    },
    "tls_protocols.sslv3": {
