  "translations": {
    "riak_api.http": {
      "properties": {},
      "comment": [],
      "configName": "riak_api.http",
      "func": "fun(Conf) -> HTTP = cuttlefish_variable:filter_by_prefix(\"listener.http\", Conf), [ IP || {_, IP} <- HTTP] end "
    },
    "riak_api.pb": {
      "properties": {},
      "comment": [],
      "configName": "riak_api.pb",
      "func": "fun(Conf) -> PB = cuttlefish_variable:filter_by_prefix(\"listener.protobuf\", Conf), [ IP || {_, IP} <- PB] end "
    },
    "riak_api.https": {
      "properties": {},
      "comment": [],
      "configName": "riak_api.https",
      "func": "fun(Conf) -> HTTPS = cuttlefish_variable:filter_by_prefix(\"listener.https\", Conf), [ IP || {_, IP} <- HTTPS] end "
    },
    "riak_api.honor_cipher_order": {
      "properties": {},
      "comment": [],
      "configName": "riak_api.honor_cipher_order",
      "func": "fun(Conf) -> CipherOrder = cuttlefish:conf_get(\"honor_cipher_order\", Conf), case CipherOrder of on  -> true; off -> false end end "
    },
    "riak_api.tls_protocols": {
      "properties": {},
      "comment": [],
      "configName": "riak_api.tls_protocols",
      "func": "fun(Conf) -> Protocols = cuttlefish_variable:filter_by_prefix(\"tls_protocols\", Conf), [begin case Key of [\"tls_protocols\",\"sslv3\"] -> sslv3; [\"tls_protocols\",\"tlsv1\"] -> tlsv1; [\"tls_protocols\",\"tlsv1\", \"1\"] -> 'tlsv1.1'; [\"tls_protocols\",\"tlsv1\", \"2\"] -> 'tlsv1.2' end end || {Key, Value} <- Protocols, Value == on] end "
    },
    "riak_api.check_crl": {
      "properties": {},
      "comment": [],
      "configName": "riak_api.check_crl",
      "func": "fun(Conf) -> CheckCRL = cuttlefish:conf_get(\"check_crl\", Conf), case CheckCRL of on -> true; off -> false end end "
    }
  },
