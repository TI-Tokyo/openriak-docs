    "rawSchema": "{mapping, \"leveldb.maximum_memory.percent\", \"eleveldb.total_leveldb_mem_percent\", [ {default, \"70\"}, {datatype, integer} ]}.",
    "comment": [
      "@doc This parameter defines the percentage of total server memory",
      "to assign to LevelDB. LevelDB will dynamically adjust its internal",
      "cache sizes to stay within this size.  The memory size can",
      "alternately be assigned as a byte count via leveldb.maximum_memory",
      "instead.",
      "@see leveldb.maximum_memory"
    ],
